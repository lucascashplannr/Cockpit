{
  "name": "@cockpit/desktop",
  "version": "0.2.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "build": "vite build",
    "bundle:core": "node scripts/bundle-core.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:renderer": "vite",
    "dist": "pnpm run build && pnpm run bundle:core && electron-builder",
    "icon": "node scripts/icon.mjs",
    "logo": "node scripts/logo.mjs",
    "pack": "pnpm run build && pnpm run bundle:core && electron-builder --dir",
    "postdist": "node scripts/rebuild-native.mjs",
    "postinstall": "node scripts/rebuild-native.mjs",
    "postpack": "node scripts/rebuild-native.mjs",
    "rebuild:native": "electron-rebuild -m . -o better-sqlite3 --force",
    "start": "electron .",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@cockpit/shared": "workspace:*",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.3.1",
    "@codemirror/lang-php": "^6.0.1",
    "@codemirror/lang-yaml": "^6.1.2",
    "@codemirror/state": "^6.5.1",
    "@codemirror/view": "^6.36.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@lucide/vue": "^1.34.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "better-sqlite3": "^11.10.0",
    "codemirror": "^6.0.1",
    "electron-updater": "^6.8.9",
    "marked": "^18.0.11",
    "node-pty": "^1.1.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^33.3.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  }
}

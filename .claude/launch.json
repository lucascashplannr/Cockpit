{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "renderer",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@cockpit/desktop",
        "run",
        "dev:renderer"
      ],
      "port": 5273,
      "url": "http://127.0.0.1:5273"
    }
  ]
}